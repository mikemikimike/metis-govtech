# Copy to .env and fill in. .env is git-ignored.

# LLM for the user agent (and any runner agent). OpenAI-compatible endpoint.
OPENAI_API_KEY=<api-key>
OPENAI_BASE_URL=<endpoint-url>

# Orca REST API, for validating against Orca.
ORCA_API_URL=<orca-api-base-url>
ORCA_API_KEY=<api-key-from-the-orca-team>
