{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Five Fields, One Turn",
    "output": "turn-example.html",
    "quality_profile": "showcase",
    "animation": "trace",
    "column_fit": "spread",
    "viewBox": [1080, 520],
    "views": [
      {
        "id": "decide-first",
        "label": "Deciding the plan",
        "focus": ["user_agent", "orchestrator"],
        "note": "The persona chooses the whole ordered sequence before anything is sent."
      },
      {
        "id": "one-request",
        "label": "One request to the target",
        "focus": ["runner", "target"],
        "note": "Five answers and the submit travel together as one request."
      },
      {
        "id": "report-back",
        "label": "Reporting the outcome",
        "focus": ["runner", "orchestrator", "user_agent"],
        "note": "Each field's result comes back on its own, not as one pass/fail flag."
      }
    ]
  },
  "participants": [
    { "id": "user_agent", "type": "external", "label": "User Agent", "sublabel": "the persona" },
    { "id": "orchestrator", "type": "backend", "label": "Orchestrator", "sublabel": "runs the turn" },
    { "id": "runner", "type": "backend", "label": "Runner", "sublabel": "talks to the target" },
    { "id": "target", "type": "cloud", "label": "Target System", "sublabel": "a five-field form" }
  ],
  "segments": [
    { "from": 160, "to": 220, "label": "Decide" },
    { "from": 230, "to": 340, "label": "One Round Trip" },
    { "from": 350, "to": 430, "label": "Report Back" }
  ],
  "messages": [
    { "id": "plan", "from": "user_agent", "to": "orchestrator", "y": 170, "label": "my plan: fill 5 fields, then submit", "variant": "emphasis" },
    { "id": "handoff", "from": "orchestrator", "to": "runner", "y": 200, "label": "pass the ordered actions along", "variant": "emphasis" },
    { "id": "request", "from": "runner", "to": "target", "y": 240, "label": "one request: 5 answers + submit", "variant": "emphasis" },
    { "id": "accepted", "from": "target", "to": "runner", "y": 280, "label": "accepted", "variant": "return" },
    { "id": "outcomes", "from": "runner", "to": "orchestrator", "y": 320, "label": "one outcome per action", "variant": "return" },
    { "id": "reveal", "from": "orchestrator", "to": "user_agent", "y": 360, "label": "see what happened, field by field", "variant": "return" }
  ],
  "activations": [
    { "participant": "orchestrator", "from": 170, "to": 360, "type": "backend" },
    { "participant": "runner", "from": 200, "to": 320, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "One Turn, One Round Trip",
      "items": [
        "Five field answers and the submit travel together",
        "The target sees one coherent request, not five separate ones"
      ]
    },
    {
      "dot": "rose",
      "title": "Still Five Outcomes",
      "items": [
        "Each field gets its own result back",
        "If field three is rejected, that's visible without guessing"
      ]
    }
  ]
}
