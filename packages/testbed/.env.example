# OpenAI-compatible model gateway used by Wizard and the similarity scorer.
# See docs/guide/models.md for the variables of each role.
OPENAI_BASE_URL=https://your-gateway.example/v1
OPENAI_API_KEY=your-api-key

# Optional. Wizard uses DEFAULT_MODEL, then gpt-6-luna, when this value is absent.
# INTERVIEW_MODEL=your-interview-model

# Optional. The embedding model of the Wizard matcher and the similarity scorer.
# Unset -> text-embedding-3-large.
# EMBEDDING_MODEL=text-embedding-3-large
