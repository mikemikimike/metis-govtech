# metis-wizard — interview LLM configuration
#
# The interview runs against any OpenAI-wire-compatible provider (e.g. Platform AI).
# Both variables are required; the wizard refuses to start without them. Give the full
# OpenAI-compatible endpoint in OPENAI_BASE_URL.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://your-gateway/v1

# Interview model — the wizard's own model on the provider above.
# INTERVIEW_MODEL=gpt-5.6-luna

# Langfuse — optional tracing. Tracing stays off unless all three are set.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://your-langfuse-host

# Model context limit and reserved maximum output (tokens).
# Set the context limit from the selected provider model configuration.
INTERVIEW_CONTEXT_TOKENS=128000
INTERVIEW_OUTPUT_TOKENS=16384
