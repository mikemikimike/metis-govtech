# metis-wizard — Interview and embedding model configuration
#
# One .env serves metis wizard, metis engine, and the API. Copy it to the repository root.
# Exported values win over this file. METIS_ENV_FILE names another file.
# See docs/guide/models.md for each role, its fallback, and the recommended models.

# Shared OpenAI-compatible gateway (for example Platform AI). Give the full endpoint.
# OPENAI_BASE_URL is optional; unset uses the default OpenAI endpoint.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://your-gateway/v1

# The model of every chat role. Unset -> gpt-6-luna.
# DEFAULT_MODEL=your-model

# Interview model. Unset -> DEFAULT_MODEL.
# INTERVIEW_MODEL=your-interview-model
# INTERVIEW_API_KEY=your-interview-key        # unset -> OPENAI_API_KEY
# INTERVIEW_BASE_URL=https://your-gateway/v1  # unset -> OPENAI_BASE_URL

# Embedding model for scorer matching. Unset -> text-embedding-3-large.
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_API_KEY=your-embedding-key        # unset -> OPENAI_API_KEY
# EMBEDDING_BASE_URL=https://your-gateway/v1  # unset -> OPENAI_BASE_URL

# Langfuse — optional tracing. Tracing stays off unless all three are set.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://your-langfuse-host

# Model context limit and reserved maximum output (tokens).
# Set the context limit from the selected provider model configuration.
INTERVIEW_CONTEXT_TOKENS=128000
INTERVIEW_OUTPUT_TOKENS=16384
