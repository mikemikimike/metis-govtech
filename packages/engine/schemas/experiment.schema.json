{
  "$defs": {
    "MetricRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "object"
        },
        {
          "properties": {
            "fqn": {
              "type": "string"
            },
            "args": {
              "additionalProperties": true,
              "type": "object"
            }
          },
          "required": [
            "fqn"
          ],
          "type": "object"
        }
      ],
      "description": "A metric reference. Accepts a plain FQN string, a single-key mapping {FQN: {args}}, or {fqn: str, args: dict}."
    },
    "Persona": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "Persona",
      "type": "object"
    },
    "Scenario": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "num_trials": {
          "default": 1,
          "title": "Num Trials",
          "type": "integer"
        },
        "fixtures": {
          "items": {
            "type": "string"
          },
          "title": "Fixtures",
          "type": "array"
        },
        "persona_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Persona Refs",
          "type": "array"
        },
        "metric_refs": {
          "items": {
            "$ref": "#/$defs/MetricRef"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "max_turns": {
          "default": 20,
          "title": "Max Turns",
          "type": "integer"
        },
        "timeout_minutes": {
          "default": 15,
          "title": "Timeout Minutes",
          "type": "integer"
        },
        "response_wait_ms": {
          "default": 300000,
          "title": "Response Wait Ms",
          "type": "integer"
        },
        "max_run_retries": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Run Retries"
        }
      },
      "required": [
        "id",
        "description",
        "persona_refs"
      ],
      "title": "Scenario",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "runner_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "FQN of a RunnerFactory class; None = metis.engine.simulation.runners.playwright.PlaywrightRunnerFactory",
      "title": "Runner Ref"
    },
    "personas": {
      "items": {
        "$ref": "#/$defs/Persona"
      },
      "minItems": 1,
      "title": "Personas",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "description",
    "personas",
    "scenarios"
  ],
  "title": "Experiment v1",
  "type": "object"
}
