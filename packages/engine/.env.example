# One .env serves metis wizard, metis engine, and the API. Copy it to the repository root.
# Exported values win over this file. METIS_ENV_FILE names another file.
# See docs/guide/models.md for each role, its fallback, and the recommended models.

# Langfuse — trace storage and retrieval
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://nprd.langfuse.ai.tech.gov.sg

# Shared OpenAI-compatible gateway. Every role uses it when the role has no override.
# Leave OPENAI_BASE_URL unset to use the default OpenAI endpoint.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://your-gateway/v1

# The model of every chat role (user agent, runner agent, judge, interview).
# A role variable below wins over it. Unset -> gpt-6-luna.
# DEFAULT_MODEL=your-model

# User agent (the simulated user, and the gen_1 artifact summariser). Affects scores.
# The Specification can set defaults.user_agent_model and Task.user_agent_model.
# USER_AGENT_MODEL=your-user-agent-model   # unset -> DEFAULT_MODEL
# USER_AGENT_API_KEY=your-user-agent-key        # unset -> OPENAI_API_KEY
# USER_AGENT_BASE_URL=https://your-gateway/v1   # unset -> OPENAI_BASE_URL
# USER_AGENT_MAX_TOKENS=4096   # unset/empty -> max_tokens omitted (provider default)
# USER_AGENT_TEMPERATURE=0.7   # unset/empty -> temperature omitted (provider default)

# Runner agent (the gen_2 generic runners). Affects scores.
# The Specification can set defaults.runner_agent_model. Unset -> the user agent model.
# RUNNER_AGENT_MODEL=your-runner-model
# RUNNER_AGENT_API_KEY=your-runner-agent-key        # unset -> USER_AGENT_API_KEY -> OPENAI_API_KEY
# RUNNER_AGENT_BASE_URL=https://your-gateway/v1     # unset -> USER_AGENT_BASE_URL -> OPENAI_BASE_URL

# Judge (model-based graders only). Affects scores.
# The Specification can set defaults.judge_model and grader_args.model.
# JUDGE_MODEL=your-judge-model   # unset -> DEFAULT_MODEL
# JUDGE_API_KEY=your-judge-api-key               # unset -> OPENAI_API_KEY
# JUDGE_BASE_URL=https://your-judge-gateway/v1   # unset -> OPENAI_BASE_URL

# Orca API runner (OrcaApiRunnerFactory) — required only when using the
# built-in Orca REST API runner. Non-API runners ignore these.
ORCA_API_URL=https://a2i-non-crisp-alb-1316108736.ap-southeast-1.elb.amazonaws.com:7443/api/v1
ORCA_API_KEY=your-orca-api-key
# Optional: your own GovTech AI Platform key. Set it to bill every turn to your
# platform project on a FIXED model. Unset, turns spend Orca's shared weekly
# allowance — and Orca silently downgrades to a cheaper model once that
# allowance is spent, which changes the model under test mid-experiment.
# ORCA_PLATFORM_AI_KEY=your-platformai-key

# Orca Playwright runner (OrcaPlaywrightRunnerFactory) — required only when
# using the built-in Orca browser runner. Non-Playwright runners ignore these.
ORCA_URL=https://eservices-sit.mom.gov.sg/a2i/orca
ORCA_USERNAME=your-orca-username
ORCA_PASSWORD=your-orca-password
