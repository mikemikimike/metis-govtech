# Langfuse — trace storage and retrieval
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://nprd.langfuse.ai.tech.gov.sg

# OpenAI-compatible provider — shared by the user agent and the judge.
# Point OPENAI_BASE_URL at any OpenAI-wire-compatible gateway (e.g. Platform AI),
# or leave it unset to use the default OpenAI endpoint.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://your-gateway/v1   # unset -> default OpenAI endpoint

# User agent (simulation persona engine) — its own model on the provider above.
# USER_AGENT_MODEL=gpt-5.6-luna
# USER_AGENT_MAX_TOKENS=4096   # unset/empty -> max_tokens omitted (provider default)
# USER_AGENT_TEMPERATURE=0.7   # unset/empty -> temperature omitted (provider default)

# LLM judge — used only by model-based graders. Its gateway falls back to the
# OPENAI_* provider above; set these to send grader LLM calls elsewhere.
# JUDGE_API_KEY=your-judge-api-key
# JUDGE_BASE_URL=https://your-judge-gateway/v1
# Judge model when neither the criterion's grader_args.model nor the
# specification's defaults.judge_model is set. Unset -> gemini-3.5-flash-lite.
# JUDGE_MODEL=gemini-3.5-flash-lite

# Orca API runner (OrcaApiRunnerFactory) — required only when using the
# built-in Orca REST API runner. Non-API runners ignore these.
ORCA_API_URL=https://a2i-non-crisp-alb-1316108736.ap-southeast-1.elb.amazonaws.com:7443/api/v1
ORCA_API_KEY=your-orca-api-key
# Optional: your own GovTech AI Platform key. Set it to bill every turn to your
# platform project on a FIXED model. Unset, turns spend Orca's shared weekly
# allowance — and Orca silently downgrades to a cheaper model once that
# allowance is spent, which changes the model under test mid-experiment.
# ORCA_PLATFORM_AI_KEY=your-platformai-key

# Orca Playwright runner (OrcaPlaywrightRunnerFactory) — required only when
# using the built-in Orca browser runner. Non-Playwright runners ignore these.
ORCA_URL=https://eservices-sit.mom.gov.sg/a2i/orca
ORCA_USERNAME=your-orca-username
ORCA_PASSWORD=your-orca-password
