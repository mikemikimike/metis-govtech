# Langfuse — trace storage and retrieval
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://nprd.langfuse.ai.tech.gov.sg

# OpenAI — judge model (GEval metrics) + user agent (simulation persona engine)
OPENAI_API_KEY=your-openai-api-key

# User agent (simulation persona engine) — override to point at any
# OpenAI-compatible provider (e.g. Platform AI). Unset values fall back as noted.
# USER_AGENT_MODEL=gpt-4o-mini
# USER_AGENT_MAX_TOKENS=1024
# USER_AGENT_TEMPERATURE=0.7
# USER_AGENT_API_KEY=your-user-agent-api-key    # falls back to OPENAI_API_KEY
# USER_AGENT_BASE_URL=https://your-gateway/v1   # unset -> default OpenAI endpoint

# LLM judge (GEval metrics) — override to point at any OpenAI-compatible
# provider (e.g. Platform AI). Unset values fall back as noted below.
# JUDGE_MODEL=gpt-4.1-mini                   # judge model name
# JUDGE_API_KEY=your-judge-api-key           # falls back to OPENAI_API_KEY
# JUDGE_BASE_URL=https://your-gateway/v1     # unset -> default OpenAI endpoint

# Orca simulation — target URL and browser login credentials
ORCA_URL=https://eservices-sit.mom.gov.sg/a2i/orca
ORCA_USERNAME=your-orca-username
ORCA_PASSWORD=your-orca-password
