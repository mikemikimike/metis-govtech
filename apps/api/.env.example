# metis-api — Interview and embedding model configuration
#
# For monorepo development, copy this file to the repository root as `.env`.
# One .env serves metis wizard, metis engine, and the API. Exported values win over this file.
# METIS_ENV_FILE names another file. See docs/guide/models.md for each role and its fallback.
#
# The API starts when a setting is missing. GET /api/v1/models then reports the missing
# variables, and the Interview routes return 503 model_unavailable.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://your-gateway/v1
# DEFAULT_MODEL=your-model                # model of every chat role; unset -> gpt-6-luna
# INTERVIEW_MODEL=your-interview-model    # unset -> DEFAULT_MODEL
# EMBEDDING_MODEL=text-embedding-3-large  # unset -> text-embedding-3-large
# INTERVIEW_API_KEY / INTERVIEW_BASE_URL and EMBEDDING_API_KEY / EMBEDDING_BASE_URL
# override the shared gateway for one role.

# API process — optional local overrides.
PORT=8001
# HOST=0.0.0.0

# Langfuse — optional wizard tracing. Tracing stays off unless all three are set.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://your-langfuse-host

# The user agent, runner agent, and judge belong to metis-engine. GET /api/v1/models
# reports their status so that the web client can show the run settings.

# Use the selected model provider context limit.
INTERVIEW_CONTEXT_TOKENS=128000
INTERVIEW_OUTPUT_TOKENS=16384
